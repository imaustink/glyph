node_modules
# Workspace packages' own node_modules (pnpm symlinks into the host's store) —
# a bare "node_modules" only matches the context root, and copying these over
# an image's fresh install leaves it resolving against the host's packages.
**/node_modules
collab/dist
build
.svelte-kit
.env
.env.*
!.env.example
*.local
# Local build and test output. src-tauri/target alone is gigabytes, and
# `COPY . .` in the Dockerfile would otherwise carry it into every build.
src-tauri/target
coverage
test-results
playwright-report
