FROM golang:1.25-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /api ./cmd/api

# ─── Final image (Alpine so healthcheck has wget) ──────────────────────────────
FROM alpine:3.20

RUN apk add --no-cache wget

COPY --from=builder /api /api

EXPOSE 8080

ENTRYPOINT ["/api"]
