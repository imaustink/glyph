DATABASE_URL=postgres://glyph:glyph@localhost:5432/glyph?sslmode=disable
PORT=8080

# Google OIDC — get these from https://console.cloud.google.com/apis/credentials
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
OIDC_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
OIDC_REDIRECT_URL=http://localhost:8081/auth/callback

# Session — hex-encoded 32-byte key. Generate with: openssl rand -hex 32
# Leave empty for auto-generated (won't survive restarts)
SESSION_SECRET=
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Where to redirect after login
FRONTEND_URL=http://localhost:5173

GIN_MODE=debug
