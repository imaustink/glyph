# Glyph — Environment Variables
#
# Copy this file to .env and customize as needed.
# Docker Compose will automatically load .env from the project root.

# ─── Database (local development) ────────────────────────────────────────────
# Used by docker-compose.postgres.yml for local Postgres
POSTGRES_DB=glyph
POSTGRES_USER=glyph
POSTGRES_PASSWORD=glyph

# ─── OIDC (optional for local dev) ────────────────────────────────────────────
# Leave empty to use dev auth mode (auto-login as "dev-user")
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# ─── Session (optional) ───────────────────────────────────────────────────────
# Hex-encoded 32-byte key. If not set, a random key is generated on each restart.
# SESSION_SECRET=

# ─── Realtime collaboration (API backend) ─────────────────────────────────────
# docker-compose.postgres.yml runs the collab service with these defaults.
# COLLAB_ENABLED=true
# COLLAB_SERVICE_TOKEN=dev-collab-service-token
# Frontend: point the collaboration WebSocket somewhere other than same-origin /collab.
# VITE_COLLAB_URL=
