{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"types": ["node"],
		"lib": ["ES2022", "DOM"],
		"paths": {
			"$lib": ["../src/lib"],
			"$lib/*": ["../src/lib/*"]
		}
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "../src/lib/editor/schema.ts", "../src/lib/collab/protocol.ts"]
}
