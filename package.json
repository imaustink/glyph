{
	"name": "@k5s/glyph",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:local": "PLAYWRIGHT_PROJECT=local playwright test --project=local",
		"test:e2e:api": "PLAYWRIGHT_PROJECT=api playwright test --project=api",
		"test:e2e:docker": "scripts/test-e2e.sh",
		"test:e2e:api:docker": "scripts/test-e2e.sh api",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@vitest/coverage-v8": "^4.1.5",
		"jsdom": "^29.0.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.4"
	},
	"dependencies": {
		"@tiptap/core": "^3.31.3",
		"@tiptap/extension-list-item": "^3.31.3",
		"@tiptap/extension-placeholder": "^3.31.3",
		"@tiptap/markdown": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"date-fns": "^4.1.0",
		"fuse.js": "^7.3.0",
		"nanoid": "^5.1.9",
		"svelte-dnd-action": "^0.9.69",
		"svelte-tiptap": "^3.0.1"
	}
}
